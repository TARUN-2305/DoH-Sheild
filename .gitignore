# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're executing a top-level application, you should omit the lockfile for libraries:
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock can be either included or excluded.
#   See: https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock can be either included or excluded.
#   See: https://pdm.fming.dev/latest/usage/project/#commit-the-lock-file
pdm.lock
.pdm-plugins/

